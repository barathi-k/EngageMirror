// Windows resource script for engagemirror.exe: app icon + version info.
// Generated from resource.rc.in by CMake (configure_file, @ONLY).

IDI_ICON1 ICON "@ENGAGEMIRROR_ICON_PATH@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "EngageMirror"
            VALUE "FileDescription", "EngageMirror - AirPlay screen mirroring receiver"
            VALUE "FileVersion", "@PROJECT_VERSION@.0"
            VALUE "InternalName", "engagemirror"
            VALUE "LegalCopyright", "Copyright (C) contributors. Licensed under GPLv3."
            VALUE "OriginalFilename", "engagemirror.exe"
            VALUE "ProductName", "EngageMirror"
            VALUE "ProductVersion", "@PROJECT_VERSION@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
